  <joint name="base_to_supporting_infrastructure" type="fixed">
    
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="supporting_infrastructure" />
    </joint>
  <joint name="x_axis_joint" type="prismatic">
    
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="x_axis_link" />
    <axis xyz="1 0 0" />
    <limit effort="1000" velocity="0.1" lower="0" upper="2.7" />
    
    </joint>
  <joint name="y_axis_joint" type="prismatic">
    
    <origin xyz="-0.39125 -0.2225 0.516325" rpy="0 0 0" />
    <parent link="x_axis_link" />
    <child link="y_axis_link" />
    <axis xyz="0 1 0" />
    <limit effort="1000" velocity="0.1" lower="0" upper="1.3" />
    
    </joint>
  <joint name="z_axis_joint" type="prismatic">
    
    <origin xyz="0.055 -0.011 0.4525" rpy="0 0 0" />
    <parent link="y_axis_link" />
    <child link="z_axis_link" />
    <axis xyz="0 0 1" />
    <limit effort="500" velocity="0.02" lower="-0.4" upper="0" />
    
    </joint>
  <link name="tool_link">
    
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.1" />
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001" />
      </inertial>
    </link>
  <joint name="joint_tool" type="fixed">
    
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="z_axis_link" />
    <child link="tool_link" />
    </joint>
  </robot>